{
  "name": "letsconnect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/prod.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run cap:sync && npm run android:gradle",
    "android:gradle": "cd android && gradlew.bat assembleDebug",
    "android:open": "npx cap open android",
    "brand:assets": "node scripts/brand-assets.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "firebase": "^13.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "sharp@0.35.5": true,
    "@capacitor/app@8.1.2": true,
    "@capacitor/browser@8.0.5": true
  }
}
