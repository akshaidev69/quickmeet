# Copy to .env.local (already created for LetsConnect Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=

# Optional classic Google OAuth (server redirect) if not using Firebase popup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:5173

# Operator console at /admin — override the bootstrap username/password
ADMIN_USERNAME=
ADMIN_PASSWORD=
